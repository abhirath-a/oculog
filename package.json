{
	"name": "oculog-workspace",
	"version": "1.0.0",
	"private": true,
	"description": "Contact lens routines, wear history, and source-grounded eye-care education.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/abhirath-a/oculog.git"
	},
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"start": "pnpm --dir mobile start",
		"ios": "pnpm --dir mobile ios",
		"api": "bash scripts/start-api.sh",
		"format": "bash scripts/biome.sh format --write .",
		"check": "bash scripts/biome.sh check .",
		"typecheck": "pnpm --dir mobile typecheck",
		"test": "pnpm test:mobile && pnpm test:backend",
		"test:mobile": "pnpm --dir mobile test",
		"test:backend": "python3 -m unittest discover -s backend/tests -v",
		"export:ios": "pnpm --dir mobile export:ios"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	}
}
