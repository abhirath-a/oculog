# Local server settings. `pnpm api` loads .env; exported variables take precedence.
# Direct uvicorn startup does not load .env automatically.
OCULOG_HOST=127.0.0.1
OCULOG_PORT=8000
# Default database is resolved from the backend module, not the launch directory.
OCULOG_DB_PATH=backend/data/oculog.sqlite3
# Comma-separated browser origins; native apps do not use browser CORS.
OCULOG_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional SERVER-ONLY adult general education. Disabled by default.
# Leave blank for local source-only development. Never commit a real key.
OCULOG_GEMINI_API_KEY=
OCULOG_GEMINI_ENABLED=false
OCULOG_GEMINI_PAID_PROJECT_ACK=false
OCULOG_GEMINI_ADULT_AUDIENCE_ACK=false
# Set to the reviewed current pricing version only after operator review.
OCULOG_GEMINI_PRICE_ACK=
# No application-side monthly spending limit. Usage estimates are recorded.
# Configure Google Cloud billing alerts, API quotas and abuse controls separately.
