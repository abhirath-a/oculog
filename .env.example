# Reference server settings: export these explicitly before pnpm api.
# The startup script does NOT load .env; existing private .env stays untouched.
API_HOST=127.0.0.1
API_PORT=8000
# Default database is resolved from the backend module, not the launch directory.
OCULOG_DB_PATH=backend/data/oculog.sqlite3
# Comma-separated browser origins; native apps do not use browser CORS.
OCULOG_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
