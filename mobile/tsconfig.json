{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"ignoreDeprecations": "6.0",
		"types": ["react"]
	},
	"include": [
		"app.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"shared/**/*.ts",
		".expo/types/**/*.ts",
		"expo-env.d.ts"
	]
}
